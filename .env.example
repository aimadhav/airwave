# Duplicate this as .env. Keys stay on the local Node server and are never sent to the browser.
PORT=4175

# Required for continuous playback with a sponsor segment inserted in-stream.
# Point this to the actual ffmpeg executable, e.g. C:\\tools\\ffmpeg\\bin\\ffmpeg.exe


# Gnani TTS and optional voice cloning (transcription uses your local STT project)
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=

# Groq text models (or enter the key in the Airwave UI; UI key is memory-only).
GROQ_API_KEY=
GROQ_MODEL_A=openai/gpt-oss-120b
GROQ_MODEL_B=qwen/qwen3.8-27b
